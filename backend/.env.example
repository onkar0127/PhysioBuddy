# Backend Environment Variables Example
# Copy this file to .env or configure these variables in your deployment environment (e.g., Render)

# Secret Key (Required in production when DEBUG=False)
SECRET_KEY=django-insecure-change-me-in-production

# Debug Mode (True for local development, False for production)
DEBUG=True

# Allowed Hosts (Comma-separated list of host/domain names)
ALLOWED_HOSTS=127.0.0.1,localhost

# CSRF Trusted Origins (Comma-separated list of trusted origins)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CORS Allowed Origins (Comma-separated list of allowed origins for cross-site HTTP requests)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000

# Email Configuration (Google SMTP with App Password)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=PhysioBuddy <your-email@gmail.com>
